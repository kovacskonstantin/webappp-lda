@{
    ViewData["Title"] = "Customer Details";
}
<h1>@ViewData["Title"]</h1>
<p>@Model.ToString()</p>

<table class="table">
    <thead>
        <tr>
             <th>ID</th>
             <th>Nev</th>
             <th>Cim</th>
             <th>Email</th>
             <th>Telefon</th>
             <th>Pontszam</th>
        </tr>
    </thead>
    <tbody>
@foreach(var customer in Model)
        {

            <tr>

                <td><a asp-area="" asp-controller="Home" asp-action="Vasarlo" asp-route-id="@customer.Id">
                Id:@customer.Id
                </a>
                </td>
                <td>Name: @customer.Nev</td>
                <td>Cim: @customer.Cim</td>
                <td>Email: @customer.Email</td>
                <td>Phone: @customer.Telefon</td>
                <td>Pontszam: @customer.Pontszam</td>
            </tr>
       
}
    </tbody>
</table>



